# ─── Telegram bot ───────────────────────────────────────────
BOT_TOKEN=123456:replace_with_token_from_botfather
BOT_USERNAME=ultrabet_predictions_bot
ADMIN_IDS=123456789

# ─── SStats.net API ─────────────────────────────────────────
# https://sstats.net/api — без ключа лимит 30 запросов/мин на IP.
# С ключом — расширенные лимиты.
SSTATS_API_KEY=
SSTATS_BASE_URL=https://api.sstats.net
SSTATS_TIMEOUT=30
SSTATS_MAX_RETRIES=3

# ─── Free tier / billing ────────────────────────────────────
FREE_PREDICTIONS_INITIAL=5
REFERRAL_BONUS_SIGNUP=3
REFERRAL_BONUS_SUB_1M=5
REFERRAL_BONUS_SUB_3M=15
REFERRAL_BONUS_SUB_12M=45

# ─── Predictions config ─────────────────────────────────────
TOP_PREDICTIONS=15
TOP_VALUE_BETS=5
MIN_VALUE_ODDS=1.20
MIN_VALUE_PERCENT=2.0

# ─── Cache TTL (seconds) ────────────────────────────────────
CACHE_TTL_TEAMS=3600
CACHE_TTL_MATCHES=900
CACHE_TTL_GAME=300
CACHE_TTL_GLICKO=600
CACHE_TTL_ODDS=180
CACHE_TTL_LEAGUES=86400

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ─── Locale ─────────────────────────────────────────────────
TIMEZONE_OFFSET=3
