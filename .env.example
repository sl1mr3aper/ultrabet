# ─── Telegram bot ───────────────────────────────────────────
BOT_TOKEN=123456:replace_with_token_from_botfather
BOT_USERNAME=ultrabet_predictions_bot
ADMIN_IDS=123456789

# ─── SStats.net API ─────────────────────────────────────────
# https://sstats.net/api — без ключа лимит 30 запросов/мин на IP.
# С ключом — расширенные лимиты.
SSTATS_API_KEY=
SSTATS_BASE_URL=https://api.sstats.net
SSTATS_TIMEOUT=30
SSTATS_MAX_RETRIES=3

# ─── Free tier / billing ────────────────────────────────────
FREE_PREDICTIONS_INITIAL=5
REFERRAL_BONUS_SIGNUP=3
REFERRAL_BONUS_SUB_1M=5
REFERRAL_BONUS_SUB_3M=15
REFERRAL_BONUS_SUB_12M=45

# ─── Predictions config ─────────────────────────────────────
TOP_PREDICTIONS=15
TOP_VALUE_BETS=5
MIN_VALUE_ODDS=1.20
MIN_VALUE_PERCENT=2.0

# ─── Cache TTL (seconds) ────────────────────────────────────
CACHE_TTL_TEAMS=3600
CACHE_TTL_MATCHES=900
CACHE_TTL_GAME=300
CACHE_TTL_GLICKO=600
CACHE_TTL_ODDS=180
CACHE_TTL_LEAGUES=86400

# ─── Database ───────────────────────────────────────────────
# По умолчанию — локальный SQLite. В production через docker-compose
# подставляется postgresql+asyncpg://ultrabet:ultrabet@postgres:5432/ultrabet
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ─── Redis (опционально) ────────────────────────────────────
# Если задан — KVCache и rate-limiter используют Redis (общий кэш между
# процессами). Иначе — in-memory TTLCache в каждом процессе.
# REDIS_URL=redis://redis:6379/0

# ─── Observability (опционально) ────────────────────────────
# Sentry: DSN от https://sentry.io/settings/<org>/projects/<proj>/keys/.
# Если не задан — sentry_sdk не инициализируется.
# SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus: 0 → выключено; иначе HTTP-сервер на 0.0.0.0:<port>/metrics.
PROMETHEUS_PORT=0

# ─── Бэкапы БД ──────────────────────────────────────────────
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=7
# Если задан S3-бакет и установлен boto3 — копия дампа уезжает в S3.
# BACKUP_S3_BUCKET=ultrabet-backups
# BACKUP_S3_PREFIX=ultrabet
# Cron-сервис в docker-compose использует:
# BACKUP_INTERVAL_HOURS=6

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ─── Locale ─────────────────────────────────────────────────
TIMEZONE_OFFSET=3

# ─── AI / Gemini (опционально, можно не задавать) ───────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TIMEOUT=15.0

# ─── Прокси для Telegram API (опционально) ──────────────────
# Если бот хостится в России / стране с блокировкой — задай SOCKS5-прокси.
# PROXY_URL=socks5://127.0.0.1:1080
